# Canvas personal access token — YOUR token only (never commit the real value).
# Load via environment variable or secret manager; never hardcode or log it.
CANVAS_TOKEN=

# MIT Parley API key (Anthropic Claude and other Parley models)
# Get from https://parley.mit.edu → Parley API
# Keep in env/secrets only; never post to Canvas or commit.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://parley.api.mit.edu

# Optional Parley overrides
# PARLEY_MODEL=bedrock/claude-sonnet-5
# PARLEY_API_KEY=   # alias for ANTHROPIC_API_KEY

# Optional Canvas overrides (homework discussion only)
# CANVAS_BASE_URL=https://canvas.mit.edu
# CANVAS_COURSE_ID=40577
# CANVAS_TOPIC_ID=448963
# CANVAS_AGENT_DRY_RUN=0
# CANVAS_AGENT_INTERVAL_HOURS=3